{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "update-file-paths.schema.json",
  "title": "Update File Paths (capability `update` v1.1)",
  "description": "Path-tier classifier for /update file <path>. Globs in declared order; first match wins. Schema enforces structure + allowed enum values.",
  "type": "object",
  "required": ["version", "default", "rules"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "default": {
      "type": "string",
      "enum": ["refuse_unclassified"]
    },
    "catch_all": {
      "type": "string",
      "enum": ["refuse_with_explicit_forward"]
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path_glob", "tier", "reason"],
        "additionalProperties": false,
        "properties": {
          "path_glob": {
            "type": "string",
            "minLength": 1,
            "description": "fnmatch-style glob; ** = any depth"
          },
          "tier": {
            "type": "string",
            "enum": ["refuse", "B", "C"]
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "description": "Why this tier; surfaced to founder on REFUSE."
          },
          "forward_to": {
            "type": "string",
            "description": "Suggested alternative command/workflow; surfaced on REFUSE."
          }
        }
      }
    }
  }
}
