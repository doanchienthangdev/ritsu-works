{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "consulting-processes.yaml — the 19 inherited domain process playbooks for /think mckinsey STRUCTURE",
  "type": "object",
  "required": ["version", "processes"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string" },
    "schema": { "type": "string" },
    "source": { "type": "string" },
    "count": { "type": "integer" },
    "processes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["slug", "title", "domain", "phases"],
        "additionalProperties": true,
        "properties": {
          "slug": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "title": { "type": "string" },
          "domain": { "type": "string" },
          "model_name": { "type": "string" },
          "when_to_use": { "type": "string" },
          "core_value": { "type": "string" },
          "phases": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["n", "name"],
              "additionalProperties": true,
              "properties": {
                "n": { "type": "integer" },
                "name": { "type": "string" },
                "goal": { "type": "string" },
                "key_question": { "type": "string" },
                "gate": { "type": "string" },
                "frameworks": { "type": "array", "items": { "type": "string" } }
              }
            }
          },
          "routing_card": {
            "type": ["object", "null"],
            "additionalProperties": true,
            "properties": {
              "trigger": { "type": "string" },
              "plugs_into": { "type": "string" },
              "value": { "type": "string" },
              "key_question": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
