{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "McKinsey deliverable-template registry (capability thinking-toolkit v2.0)",
  "type": "object",
  "required": ["version", "schema", "mckinsey_templates"],
  "additionalProperties": true,
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "schema": { "type": "string" },
    "mckinsey_templates": {
      "type": "array",
      "minItems": 1,
      "description": "The McKinsey Sell STRUCTURE templates. The brand/design layer is orthogonal (--style); a template carries NO color/brand token — enforced at L2 by validate-mckinsey-templates.cjs FORBIDDEN_BRAND_KEYS.",
      "items": {
        "type": "object",
        "required": ["id", "name", "when_to_use", "audience", "structure", "rules", "default_format"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "kebab id; the --sell=<id> value." },
          "name": { "type": "string", "minLength": 1 },
          "when_to_use": { "type": "string", "minLength": 1 },
          "audience": { "type": "string", "enum": ["receptive", "skeptical", "both"] },
          "structure": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The ordered McKinsey skeleton sections (prose)." },
          "rules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "The McKinsey standards the IR must satisfy (pyramid, action titles, MECE, SCR/SCQA, APK, pre-wire, so-what)." },
          "default_format": { "type": "string", "minLength": 1, "description": "The default deepask/format medium for this template (article/pdf/pptx/html/...)." }
        }
      }
    }
  }
}
