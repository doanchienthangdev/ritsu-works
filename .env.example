# ============================================================================
# ritsu-works .env.example
# ============================================================================
# Copy to runtime/secrets/.env.local and fill in your credentials.
# NEVER commit the actual .env file (only this template).
#
# 3 LLM Access Modes (see playbook chương 30 for full explanation):
#   1. SUBSCRIPTION-ONLY: Leave ANTHROPIC_API_KEY and OPENAI_API_KEY empty.
#      Use Claude Pro/Max via Claude Code only. ~50% Phase A.2 features.
#      Cost: $20-100/mo (subscription only).
#
#   2. HYBRID (RECOMMENDED v1.0): Fill in selective API keys.
#      Autonomous skills selectively enabled via knowledge/feature-flags.yaml.
#      Cost: $45-65/mo.
#
#   3. FULL API (v1.5+): All API keys + all feature flags enabled.
#      Cost: $160-300/mo.
# ============================================================================

# === Deployment Mode (Bước A or B) ===
# local: workers run on this laptop (Bước A)
# production: this is the VPS (Bước B)
RITSU_DEPLOYMENT_MODE=local

# === Workers location ===
# local: pnpm workers run here
# vps:   workers on remote VPS (Bước B)
RITSU_WORKERS_LOCATION=local

# === Telegram bot location ===
# local: bot runs here when laptop on
# vps:   bot 24/7 on VPS (Bước B)
# disabled: not running
RITSU_TELEGRAM_BOT_LOCATION=disabled

# === MCP Server mode ===
# stdio: Claude Code direct subprocess (default Bước A)
# http:  HTTP server (mcp.ritsu.ai for Bước B)
RITSU_MCP_SERVER_MODE=stdio
RITSU_MCP_HTTP_PORT=3001
RITSU_MCP_HTTP_URL=http://localhost:3001
# RITSU_MCP_HTTP_URL=https://mcp.ritsu.ai      # uncomment for Bước B

# ============================================================================
# ⚠️  MULTI-USER SECURITY NOTICE (capability multi-user-auth)
# ============================================================================
# Several keys below are PRIVILEGED (service_role, Stripe secret, GitHub/Telegram
# bot tokens). Today they are required because the MCP runs locally as service_role.
# Sprint 1 of multi-user-auth replaces them with a PER-HUMAN credential issued at
# enrollment (Supabase Auth + per-tier RLS), after which co-founders (admin/user
# tier) will NOT hold these keys — only OWNERS will. See:
#   .archives/cla/multi-user-auth/01-spec.md   (the migration plan)
#   governance/operators.yaml + knowledge/operator-tiers.yaml   (the tier model)
# DO NOT share this file. It is local-only (gitignored). One leaked .env.local
# today = full access to shared company state. Treat every value as a live secret.
RITSU_AUTH_MODE=service-key             # service-key (today) | per-human (Sprint 1, owner flips)

# ============================================================================
# Supabase (REQUIRED — Wave 1)
# ============================================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...
# ⚠️ OWNER-TIER ONLY after Sprint 1. service_role BYPASSES RLS — a god key on the
#    shared ops DB. admin/user tiers will use a per-human credential instead.
SUPABASE_SERVICE_KEY=eyJhbGc...        # for server-side migrations + admin (owner-only)

# ============================================================================
# LLM Providers
# ============================================================================
# 
# SUBSCRIPTION-ONLY MODE: Leave both empty.
# All LLM work happens in Claude Code session manually.
#
# HYBRID MODE: Fill in for autonomous high-leverage skills.
#   - Anthropic: morning brief, pre-call dossier, voice classification
#   - OpenAI: Whisper transcription, embeddings
#
# FULL API MODE: Fill in + set mode: full_api in feature-flags.yaml.
#

# Anthropic API (autonomous Claude calls — for hybrid + full_api modes)
ANTHROPIC_API_KEY=
# Get from: https://console.anthropic.com/

# OpenAI API (Whisper + embeddings — for hybrid + full_api modes)
OPENAI_API_KEY=
# Get from: https://platform.openai.com/

# ============================================================================
# Telegram (Wave 2-3, Bài #6 sub-domain B + Bài #17 surface)
# ============================================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_FOUNDER_CHAT_ID=               # founder Telegram user ID
TELEGRAM_BOT_USERNAME=

# ============================================================================
# Email (Wave 6, Bài #17 surface)
# ============================================================================
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
EMAIL_IMAP_HOST=
EMAIL_IMAP_PORT=993
EMAIL_INGEST_ADDRESS=ingest@ritsu.ai

# ============================================================================
# Stripe (Wave 5+, Bài #16 customer + Bài #11 webhook events)
# ============================================================================
# ⚠️ OWNER-TIER ONLY. A money-moving key. Per SECRETS.md no agent holds this;
#    money-out is founder ceremony. Never put this on an admin/user laptop.
#    Sprint 2 moves money behind a server-side broker action (owner-authenticated).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=

# ============================================================================
# GitHub (Bài #11 events + auto-deploy Phase B)
# ============================================================================
GITHUB_TOKEN=
GITHUB_WEBHOOK_SECRET=

# ============================================================================
# Runtime config
# ============================================================================
RITSU_ENV=development                    # development | staging | production
RITSU_LOG_LEVEL=info                     # debug | info | warn | error
RITSU_LOCALE_DEFAULT=vi                  # primary locale (Bài #17)
RITSU_DATA_REGION=eu                     # eu | us | apac (Bài #16)
RITSU_TIMEZONE=Asia/Ho_Chi_Minh

# ============================================================================
# Cost limits (Bài #7 economic unit)
# ============================================================================
RITSU_DAILY_BUDGET_USD=10
RITSU_DAILY_WHISPER_MINUTES_MAX=60
RITSU_DAILY_LLM_TOKENS_MAX=1000000

# ============================================================================
# Multi-surface APIs (Bài #17, Wave 6+)
# ============================================================================
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
WHATSAPP_BUSINESS_TOKEN=
DISCORD_BOT_TOKEN=
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# ============================================================================
# VPS deployment (Bước B trigger)
# ============================================================================
DEPLOY_VPS_HOST=
DEPLOY_VPS_USER=ritsu
DEPLOY_BRANCH=main

# ============================================================================
# Optional: external services
# ============================================================================
SENTRY_DSN=                              # error tracking
POSTHOG_API_KEY=                         # analytics (privacy-respectful)
